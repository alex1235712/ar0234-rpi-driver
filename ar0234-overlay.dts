// SPDX-License-Identifier: GPL-2.0-only
/*
 * AR0234 (Kurokesu) on the LubanCat CSI0 connector - first bring-up overlay.
 *
 * Modelled on rk356x-lubancat-csi0-ov8858-1632x1224-30fps-overlay.dts.
 *
 * The OV8858 overlay only flips "status" because the base device tree
 * already contains a complete, disabled OV8858 node on &i2c1 (clock, pinctrl,
 * power-domain, reset/power GPIOs, supplies and the endpoint wired to the
 * CSI-2 D-PHY). This overlay re-uses that node as the AR0234: it keeps all
 * the board wiring and only replaces what identifies the sensor.
 *
 * Only the labels used by the OV8858 overlay (&ov8858, &i2c1) are referenced,
 * because those are the only ones known to exist in the base DTB.
 *
 * Not verified on hardware, see the notes delivered with this file.
 */
/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target = <&i2c1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@1 {
		target = <&ov8858>;
		__overlay__ {
			status = "okay";

			/* Make the ar0234 driver bind instead of ov8858 */
			compatible = "onnn,ar0234cs";

			/* AR0234 I2C address (the OV8858 node uses 0x36) */
			reg = <0x10>;

			/* Rockchip module information, read by the driver
			 * and used by rkaiq to pick the IQ file */
			rockchip,camera-module-index = <0>;
			rockchip,camera-module-facing = "back";
			rockchip,camera-module-name = "kurokesu";
			rockchip,camera-module-lens-name = "default";

			port {
				endpoint {
					/*
					 * AR0234 on a 15-pin CSI connector
					 * uses 2 data lanes.
					 */
					data-lanes = <1 2>;

					/*
					 * The FIRST value selects the driver
					 * configuration:
					 *   450000000 -> 10-bit (SGRBG10)
					 *   360000000 ->  8-bit (SGRBG8)
					 */
					link-frequencies =
						/bits/ 64 <450000000>;
				};
			};
		};
	};
};
